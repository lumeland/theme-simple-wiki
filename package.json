{
  "name": "@lumeland/theme-simple-wiki",
  "version": "1.0.0-beta-1",
  "description": "Lume theme to create a wiki",
  "license": "MIT",
  "author": "Óscar Otero",
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./mod.ts"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p . && cp -r src build",
    "fmt": "oxfmt ."
  },
  "dependencies": {
    "@lumeland/cms": "^1.0.0",
    "@lumeland/plugin-base-path": "workspace:^",
    "@lumeland/plugin-cms": "workspace:^",
    "@lumeland/plugin-date": "workspace:^",
    "@lumeland/plugin-extract-order": "workspace:^",
    "@lumeland/plugin-favicon": "workspace:^",
    "@lumeland/plugin-icons": "workspace:^",
    "@lumeland/plugin-lightningcss": "workspace:^",
    "@lumeland/plugin-markdown-footnotes": "workspace:^",
    "@lumeland/plugin-multilanguage": "workspace:^",
    "@lumeland/plugin-nav": "workspace:^",
    "@lumeland/plugin-pagefind": "workspace:^",
    "@lumeland/plugin-prism": "workspace:^",
    "@lumeland/plugin-resolve-urls": "workspace:^",
    "@lumeland/plugin-toc": "workspace:^",
    "@mdit/plugin-alert": "^2.0.3"
  },
  "devDependencies": {
    "@lumeland/lume": "workspace:^",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@lumeland/core": "workspace:^"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
